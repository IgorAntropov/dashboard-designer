#!/bin/sh
set -e

root=$(git rev-parse --show-toplevel)
file="$root/VERSION"

if [ -f "$file" ]; then
  current=$(tr -d '[:space:]' < "$file")
else
  current="0.0.0"
fi

major=${current%%.*}
rest=${current#*.}
minor=${rest%%.*}
patch=${rest##*.}

patch=$((patch + 1))
if [ "$patch" -gt 99 ]; then
  patch=0
  minor=$((minor + 1))
fi
if [ "$minor" -gt 99 ]; then
  minor=0
  major=$((major + 1))
fi

next="$major.$minor.$patch"
printf '%s\n' "$next" > "$file"
git add "$file"
