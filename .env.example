PANELKA_ENVIRONMENT=development
PANELKA_DATABASE_URL=postgresql+asyncpg://panelka:panelka@localhost:5432/panelka
PANELKA_REDIS_URL=redis://localhost:6379/0
PANELKA_CORS_ORIGINS=http://localhost:3000

PANELKA_JWT_SECRET=change-me
PANELKA_JWT_ACCESS_TTL_SEC=900
PANELKA_JWT_REFRESH_TTL_SEC=1209600

PANELKA_FRONTEND_URL=http://localhost:3000
PANELKA_OAUTH_REDIRECT_BASE=http://localhost:8000/api/v1/auth/oauth
PANELKA_OAUTH_YANDEX_CLIENT_ID=
PANELKA_OAUTH_YANDEX_CLIENT_SECRET=
PANELKA_OAUTH_VK_CLIENT_ID=
PANELKA_OAUTH_VK_CLIENT_SECRET=

PANELKA_CLOUDPAYMENTS_PUBLIC_ID=
PANELKA_CLOUDPAYMENTS_API_SECRET=

NUXT_PUBLIC_API_ORIGIN=http://localhost:8000

# Host ports published by docker compose (change if a port is already in use).
# Internal container ports are fixed; these only affect access from your machine.
POSTGRES_PORT=5433
REDIS_PORT=6380
BACKEND_PORT=8000
FRONTEND_PORT=3000
