{
  "name": "@panelka/embed",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/panelka-embed.umd.cjs",
  "module": "./dist/panelka-embed.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/panelka-embed.js",
      "require": "./dist/panelka-embed.umd.cjs"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@panelka/renderer": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vite-plugin-dts": "^4.3.0",
    "vitest": "^2.1.3"
  }
}
